\contentsline {figure}{\numberline {3.5}{\ignorespaces Architecture of the YOLOv8 illustrating the successive stages of the model.}}{70}{figure.caption.29}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Two-row architecture of the DenseNet121-based medical image routing model.}}{74}{figure.caption.30}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces High-level overview of the multi-stage chest disease classification pipeline.}}{77}{figure.caption.31}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Chest X-ray images before and after preprocessing, highlighting improved contrast and reduced noise.}}{78}{figure.caption.32}%
\contentsline {figure}{\numberline {3.9}{\ignorespaces The U-Net architecture, illustrating the encoder-decoder structure with skip connections that merge high-resolution features from the contracting path with upsampled features in the expansive path. This design is highly effective for precise medical image segmentation.}}{79}{figure.caption.33}%
\contentsline {figure}{\numberline {3.10}{\ignorespaces Application of the U-Net segmentation mask. The original preprocessed Figure~\ref {fig:proc-cxr} is processed to produce the final segmented lung Figure~\ref {fig:segmented-lung}, which serves as the input for the classification stage}}{80}{figure.caption.34}%
\contentsline {figure}{\numberline {3.11}{\ignorespaces Grad-CAM visualizations highlighting regions contributing to model predictions.}}{80}{figure.caption.35}%
