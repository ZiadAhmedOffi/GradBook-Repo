\contentsline {figure}{\numberline {3.1}{\ignorespaces High-level architecture of the proposed framework. The system consists of a modality routing model, specialized disease classifiers, Explainable AI modules, and a Federated Learning infrastructure connecting multiple healthcare institutions.}}{64}{figure.caption.18}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Classification tree of the proposed two-level framework. The routing model first determines the image modality before directing the image toward the appropriate disease-specific classifier.}}{66}{figure.caption.19}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Architecture of the ResNet50 illustrating the successive stages of the model.}}{71}{figure.caption.20}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Overall architecture of DenseNet121 showing the arrangement of dense blocks, transition layers, and the final classification stage.}}{73}{figure.caption.21}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces General architecture of YOLOv8 illustrating the backbone, neck, and detection head components.}}{78}{figure.caption.32}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces End-to-end processing pipeline of the proposed YOLOv8 lung cancer detection model.}}{79}{figure.caption.33}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces Multi-scale feature extraction employed by YOLOv8 for detecting lung lesions of varying sizes.}}{81}{figure.caption.38}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Non-Maximum Suppression procedure used to remove duplicate detections and retain the highest-confidence prediction.}}{82}{figure.caption.42}%
\contentsline {figure}{\numberline {3.9}{\ignorespaces Functional computational pipeline of the CheXFound framework: Transitioning from input image patch serialization, through the ViT-Large encoder blocks, to the GLoRI cross-attention alignment module.}}{87}{figure.caption.52}%
\contentsline {figure}{\numberline {3.10}{\ignorespaces Modular schematic layout detailing parameter extraction, input token construction, and feature routing pathways between the frozen base model and the target task head.}}{88}{figure.caption.53}%
\contentsline {figure}{\numberline {3.11}{\ignorespaces Two-row architecture of the DenseNet121-based medical image routing model.}}{91}{figure.caption.54}%
\contentsline {figure}{\numberline {3.12}{\ignorespaces Architectures and workflow investigated during the implementation of the routing model. Blue blocks represent inputs, green blocks denote processing stages, and orange blocks correspond to classification outputs.}}{95}{figure.caption.55}%
\contentsline {figure}{\numberline {3.13}{\ignorespaces Overall architecture of the proposed chest disease multi-class classification system, illustrating the sequential pipeline from raw CXR acquisition through preprocessing, lung segmentation, deep classification, and visual explainability.}}{101}{figure.caption.56}%
\contentsline {figure}{\numberline {3.14}{\ignorespaces Representative chest radiograph samples from each of the four target diagnostic classes. The subtle visual differences between COVID-19 and Pneumonia are clear, underscoring the difficulty of the classification task.}}{105}{figure.caption.66}%
\contentsline {figure}{\numberline {3.15}{\ignorespaces Comparison of a Pneumonia chest radiograph before (left) and after (right).}}{107}{figure.caption.73}%
\contentsline {figure}{\numberline {3.16}{\ignorespaces Comparison of a Tuberculosis chest radiograph before (left) and after (right) the preprocessing pipeline.}}{107}{figure.caption.74}%
\contentsline {figure}{\numberline {3.17}{\ignorespaces Representative image–mask pair from the Darwin lung segmentation dataset. The mask precisely delineates both lung fields including regions behind the cardiac shadow.}}{108}{figure.caption.76}%
\contentsline {figure}{\numberline {3.18}{\ignorespaces U-Net architecture implemented for lung segmentation. The contracting path (left) captures contextual information through successive down sampling, while the expansive path (right) enables precise localization via skip connections. Tensor shapes are annotated at each level.}}{111}{figure.caption.85}%
\contentsline {figure}{\numberline {3.19}{\ignorespaces U-Net segmentation results. From left to right: the preprocessed input radiograph, the predicted binary lung mask, and the masked output image passed to the classification stage.}}{113}{figure.caption.89}%
\contentsline {figure}{\numberline {3.20}{\ignorespaces Proposed DenseNet121 OVR classification model architecture. The base network produces a 1024-dimensional feature vector via Global Average Pooling, which is refined through the custom classification head before producing independent sigmoid probability scores for each diagnostic class.}}{115}{figure.caption.91}%
\contentsline {figure}{\numberline {3.21}{\ignorespaces Grad-CAM visualization results for Pneumonia representative case. The saliency maps confirm that the model attends to pathologically relevant lung regions.}}{118}{figure.caption.100}%
\contentsline {figure}{\numberline {3.22}{\ignorespaces Grad-CAM visualization results for Tuberculosis cases. The upper-lower lobe localization of saliency for TB cases confirms the model's ability to recognize TB-specific radiological patterns.}}{118}{figure.caption.101}%
\contentsline {figure}{\numberline {3.23}{\ignorespaces YOLOv8 architecture pipeline for automated localization and classification of pulmonary abnormalities.}}{120}{figure.caption.102}%
