\contentsline {figure}{\numberline {3.5}{\ignorespaces General architecture of YOLOv8 illustrating the backbone, neck, and detection head components.}}{69}{figure.caption.29}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces End-to-end processing pipeline of the proposed YOLOv8 lung cancer detection model.}}{70}{figure.caption.30}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces Multi-scale feature extraction employed by YOLOv8 for detecting lung lesions of varying sizes.}}{72}{figure.caption.35}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Non-Maximum Suppression procedure used to remove duplicate detections and retain the highest-confidence prediction.}}{73}{figure.caption.39}%
